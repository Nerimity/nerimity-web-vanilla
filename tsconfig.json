{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@nerimity/jsx",
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "ESNext.Temporal", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@trans": ["./src/Trans.ts"],
      "@nerimity/jsx/*": ["./src/jsx-runtime/*"]
    }
  },
  "include": ["src", "vite.config.ts", "zoomist.d.ts"]
}
